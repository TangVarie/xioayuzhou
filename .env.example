# ════════════════════════════════════════════════════════════════
# 必填（没默认值，不填服务起不来）
# ════════════════════════════════════════════════════════════════

# 飞书自建应用凭证（开放平台 > 我的应用 > 凭证与基础信息）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 目标多维表格（地址 https://feishu.cn/base/<app_token>?table=<table_id>&...）
FEISHU_APP_TOKEN=VDGEwFu8mipstnkxCclcXvqFngh
FEISHU_TABLE_ID=tblATLLvx1MNgnrl

# 飞书自动化流程在 HTTP 请求节点里塞 X-Trigger-Secret，与下面保持一致
FEISHU_WEBHOOK_SECRET=change-me-to-a-long-random-string

# 保护 /admin/* 路由（登录、调试、扫表），通过 ?token=xxx 传入
ADMIN_TOKEN=change-me-to-a-long-random-string

# Fernet 密钥，用于加密登录态。生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-to-a-valid-fernet-key

# ════════════════════════════════════════════════════════════════
# 持久化（Railway 上挂一个 Volume 到 /data 即可）
# ════════════════════════════════════════════════════════════════

# 登录态 + scrape_log.jsonl 都写到这里。本地开发可以改成 ./data
STATE_DIR=/data

# ════════════════════════════════════════════════════════════════
# 飞书表字段映射 —— 改了这里 = 改了飞书列名 + zhuiguang 页面上的中文标签
# 默认值跟当前页面/表头一致，没改名就别动
# ════════════════════════════════════════════════════════════════

FEISHU_LINK_FIELD=节目详情追光链接

FIELD_SUBSCRIBERS=订阅数
FIELD_AVG_LISTEN=平均收听量
FIELD_AVG_DURATION=平均节目时长
FIELD_AVG_PLAY=平均播放时长
FIELD_AVG_COMMENTS=平均评论数
FIELD_FEMALE_RATIO=订阅用户女性占比
FIELD_AGE_DISTRIBUTION=订阅用户主要年龄分布
FIELD_LOCATION_DISTRIBUTION=用户主要地域分布
FIELD_IPHONE_RATIO=订阅用户设备iphone占比

# ════════════════════════════════════════════════════════════════
# 飞书 API
# ════════════════════════════════════════════════════════════════

# 国际版 Lark 改成 https://open.larksuite.com/open-apis
FEISHU_OPEN_API_BASE=https://open.feishu.cn/open-apis

# 列表接口分页大小（飞书上限 500）
FEISHU_PAGE_SIZE=200

# ════════════════════════════════════════════════════════════════
# 抓取行为
# ════════════════════════════════════════════════════════════════

ZHUIGUANG_BASE_URL=https://zhuiguang.xyz

# 首次登录时浏览器先打开的页面
ZHUIGUANG_LOGIN_URL=https://zhuiguang.xyz/

# 登录成功的判定：URL 里出现下列任一子串 + 有 session-like cookie 就 dump
LOGIN_SUCCESS_URL_HINTS=/advertiser,/dashboard,/home
SESSION_COOKIE_HINTS=session,token,auth,sid,passport,user

# 抓取页面时等到这个 selector 出现再开始解析（Playwright text= 语法）
# 改成空字符串可以跳过等待
SCRAPE_READY_SELECTOR=text=订阅数

# 超时（毫秒）
SCRAPE_NAV_TIMEOUT_MS=60000
SCRAPE_READY_TIMEOUT_MS=15000

# 抓取浏览器的虚拟屏幕分辨率，同时也是 Xvfb 分辨率和 noVNC 显示尺寸
SCREEN_WIDTH=1440
SCREEN_HEIGHT=900

# ════════════════════════════════════════════════════════════════
# 调度与批量
# ════════════════════════════════════════════════════════════════

# 内置定时任务：每天 UTC 这个小时跑一次 scan_all 全表刷新
# 默认 UTC 20:00 = 北京 04:00；改成 0 表示午夜
ENABLE_DAILY_SCAN=1
DAILY_SCAN_HOUR_UTC=20

# scan_all 里每抓完一行歇多少秒（避免被 zhuiguang 限速）
SCAN_DELAY_SECONDS=1.0

# ════════════════════════════════════════════════════════════════
# 容器内部（一般不用动）
# ════════════════════════════════════════════════════════════════

DISPLAY=:99
NOVNC_PORT=6080
PORT=8000
