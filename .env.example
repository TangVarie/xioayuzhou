# 飞书自建应用凭证（开放平台 > 我的应用 > 凭证与基础信息）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 飞书多维表格地址：https://feishu.cn/base/<app_token>?table=<table_id>&...
FEISHU_APP_TOKEN=VDGEwFu8mipstnkxCclcXvqFngh
FEISHU_TABLE_ID=tblATLLvx1MNgnrl

# 飞书自动化流程里在 HTTP 请求节点的 Header 中带 X-Trigger-Secret 校验
FEISHU_WEBHOOK_SECRET=change-me-to-a-long-random-string

# 保护 /admin/* 路由（登录、调试），通过 ?token=xxx 或 Header X-Admin-Token 传入
ADMIN_TOKEN=change-me-to-a-long-random-string

# Fernet 密钥，用于加密 storage_state；生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-to-a-valid-fernet-key

# Railway Volume 挂载路径，所有持久数据（登录态、日志）都写到这里
# Railway Dashboard 里加一个 Volume，挂载点设置成 /data 即可。
# 本地开发可以改成 ./data
STATE_DIR=/data

# 目标站
ZHUIGUANG_BASE_URL=https://zhuiguang.xyz

# Playwright + Xvfb（容器内默认即可，本地调试无需改动）
DISPLAY=:99
NOVNC_PORT=6080

# Railway 默认会注入 PORT，本地调试用下面这个
PORT=8000

# 内置调度：每天 UTC 20:00（北京 04:00）跑一次全表 scan_all。设为 0 关闭。
ENABLE_DAILY_SCAN=1
DAILY_SCAN_HOUR_UTC=20
