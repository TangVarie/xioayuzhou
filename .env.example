# ════════════════════════════════════════════════════════════════
# 必填（没默认值，不填服务起不来）
# ════════════════════════════════════════════════════════════════

# 飞书自建应用凭证（开放平台 > 我的应用 > 凭证与基础信息）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 目标多维表格（地址 https://feishu.cn/base/<app_token>?table=<table_id>&...）
FEISHU_APP_TOKEN=VDGEwFu8mipstnkxCclcXvqFngh
FEISHU_TABLE_ID=tblATLLvx1MNgnrl

# 飞书自动化流程在 HTTP 请求节点里塞 X-Trigger-Secret，与下面保持一致
FEISHU_WEBHOOK_SECRET=change-me-to-a-long-random-string

# 保护 /admin/* 路由（登录、调试、扫表），通过 ?token=xxx 传入
ADMIN_TOKEN=change-me-to-a-long-random-string

# Fernet 密钥，用于加密登录态。生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-to-a-valid-fernet-key

# ════════════════════════════════════════════════════════════════
# 持久化（Railway 上挂一个 Volume 到 /data 即可）
# ════════════════════════════════════════════════════════════════

# 登录态 + scrape_log.jsonl 都写到这里。本地开发可以改成 ./data
STATE_DIR=/data

# ════════════════════════════════════════════════════════════════
# 飞书表字段映射 —— 改了这里 = 改飞书列名
# 默认值跟当前表头一致，没改名就别动
# ════════════════════════════════════════════════════════════════

FEISHU_LINK_FIELD=节目详情追光链接

FIELD_SUBSCRIBERS=订阅数
FIELD_AVG_LISTEN=平均收听量
FIELD_AVG_DURATION=平均节目时长
FIELD_AVG_PLAY=平均播放时长
FIELD_AVG_COMMENTS=平均评论数
FIELD_FEMALE_RATIO=订阅用户女性占比
FIELD_AGE_DISTRIBUTION=订阅用户主要年龄分布
FIELD_LOCATION_DISTRIBUTION=用户主要地域分布
FIELD_IPHONE_RATIO=订阅用户设备iphone占比
